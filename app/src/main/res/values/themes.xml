<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EzBookKeeping" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#16865C</item>
        <item name="android:navigationBarColor">#F8FBF9</item>
        <item name="android:statusBarColor">#F8FBF9</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>

    <style name="Theme.EzBookKeeping.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
